# Every setting this app reads. Copy this file to .env for local work. .env is never committed.
# Names and comments only: real values go in .env, or in the DigitalOcean app's environment variables
# (app-level for the settings every app shares, component-level for this app's own).
# docs/SETUP.md in emg-portal explains where each value comes from.

# Port to listen on. Empty means 3000. Not set by hand on DigitalOcean.
PORT=
# true on DigitalOcean (app-level; the browser uses https). Keep it set there: it marks the cookie Secure, and
# DigitalOcean does not set RENDER, so it is also what tells the app it serves real people. Empty or false locally.
COOKIE_SECURE=
# production on a live component if wanted (component-level). It also tells the app it serves real people.
NODE_ENV=

# --- Who this app is, and where the portal is ---
# This app's id, lower case. It must match the id in server/app/index.js. For this app: agig-nomination.
APP_ID=
# This app's own public address, no path, for example https://ticketing-test.apps.energymatrix.com.au. Local: http://localhost:4001.
APP_URL=
# The portal's public address, for example https://portal-test.apps.energymatrix.com.au. Local: http://localhost:4000.
PORTAL_URL=
# The portal's PUBLIC signing key (PEM, or the PEM base64-encoded). Never the private key.
PORTAL_SIGNING_PUBLIC_KEY=
# At least 32 random characters. Signs this app's session cookie. A different value in every component,
# component-level and marked Encrypt. DigitalOcean does not generate it.
APP_SESSION_SECRET=
# How long a sign-in lasts, in minutes. Empty means 30. It does not slide: after this the portal signs the person in again.
APP_SESSION_MINUTES=
# The same value as on the portal. Lets this app look up portal users. Leave empty if the app never does.
PORTAL_DIRECTORY_TOKEN=

# --- This app's database (Azure SQL). Leave SQL_SERVER empty to run in memory. ---
SQL_SERVER=
# This app's own database on that server. The app makes the design's ref, nom and ops schemas in it, or uses
# them as they are if the design's setup script already made them.
AGIG_NOMINATION_SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
# true (or empty) while the databases pause when idle, as in the test environment. Set false in production.
SQL_AUTO_PAUSE=

# --- AGIG nominations (component-level) ---
# NP or PROD: which AGIG system the files are for. Empty means NP. PROD shows a red banner on every page.
NOM_ENVIRONMENT=
# The participant name AGIG gave you, exactly: it goes in every file name (SHNOM_<name>_<time>.csv).
# Until it is set, batches are approved but no file is made.
NOM_PARTICIPANT=
# false: an operator approves each batch on its page. Empty or true: publishing is the approval.
NOM_AUTO_APPROVE=
# Minutes to wait for AGIG's answer before a file is "no answer" and an alert goes out. Empty means 20.
NOM_RESPONSE_TIMEOUT_MINUTES=
# Minutes before a cutoff to warn about unsent numbers or nothing accepted. Empty means 60.
NOM_CUTOFF_WARNING_MINUTES=
# Perth time on the day before a Gas Day to alert if nothing is accepted for it yet. Empty means 13:00.
NOM_INITIAL_ALERT_TIME=
# When AGIG's SFTP key expires, yyyy-mm-dd. Alerts at 45, 14 and 3 days. The key itself stays on the office VM.
NOM_SFTP_KEY_EXPIRES=
# The upload agent's token (scripts/agent/README.md): a long random value, marked Encrypt. Empty: files are
# uploaded by hand with WinSCP and marked as uploaded on the batch's page.
NOM_AGENT_TOKEN=

# --- AGIG's response emails, read with Microsoft Graph: all four of the first four, or none ---
# The app registration's tenant and client, and its secret (Encrypt). It needs Mail.ReadWrite (application),
# limited to the response mailbox by an Exchange application access policy.
NOM_MAIL_TENANT_ID=
NOM_MAIL_CLIENT_ID=
NOM_MAIL_CLIENT_SECRET=
# The shared mailbox AGIG sends responses to.
NOM_MAIL_MAILBOX=
# Only emails from this address are read. Empty reads every unread email in the inbox.
NOM_MAIL_AGIG_SENDER=
# Seconds between mailbox reads, 15 to 3600. Empty means 60.
NOM_MAIL_POLL_SECONDS=

# --- Alerts to Teams ---
# A Teams Workflows webhook ("Post to a channel when a webhook request is received"). Empty: alerts show in the app only.
NOM_TEAMS_WEBHOOK_URL=
