# Every setting this app reads. Copy this file to .env for local work. .env is never committed.
# Names and comments only: real values go in .env, or in the DigitalOcean app's environment variables
# (app-level for the settings every app shares, component-level for this app's own).
# docs/SETUP.md in emg-portal explains where each value comes from.

# Port to listen on. Empty means 3000. Not set by hand on DigitalOcean.
PORT=
# true on DigitalOcean (app-level; the browser uses https). Keep it set there: it marks the cookie Secure, and
# DigitalOcean does not set RENDER, so it is also what tells the app it serves real people. Empty or false locally.
COOKIE_SECURE=
# production on a live component if wanted (component-level). It also tells the app it serves real people.
NODE_ENV=

# --- Who this app is, and where the portal is ---
# This app's id, lower case. It must match the id in server/app/index.js. For this app: agig-nomination.
APP_ID=
# This app's own public address, no path, for example https://ticketing-test.apps.energymatrix.com.au. Local: http://localhost:4001.
APP_URL=
# The portal's public address, for example https://portal-test.apps.energymatrix.com.au. Local: http://localhost:4000.
PORTAL_URL=
# The portal's PUBLIC signing key (PEM, or the PEM base64-encoded). Never the private key.
PORTAL_SIGNING_PUBLIC_KEY=
# At least 32 random characters. Signs this app's session cookie. A different value in every component,
# component-level and marked Encrypt. DigitalOcean does not generate it.
APP_SESSION_SECRET=
# How long a sign-in lasts, in minutes. Empty means 30. It does not slide: after this the portal signs the person in again.
APP_SESSION_MINUTES=
# The same value as on the portal. Lets this app look up portal users. Leave empty if the app never does.
PORTAL_DIRECTORY_TOKEN=

# --- This app's database (Azure SQL). Leave SQL_SERVER empty to run in memory. ---
SQL_SERVER=
# This app's own database on that server. Created empty; the app creates its tables in its own schema.
AGIG_NOMINATION_SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
# true (or empty) while the databases pause when idle, as in the test environment. Set false in production.
SQL_AUTO_PAUSE=
